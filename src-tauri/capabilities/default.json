{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app window may do on every platform",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://api.openverse.org/*" }, { "url": "https://generativelanguage.googleapis.com/*" }, { "url": "https://api.anthropic.com/*" }]
    }
  ]
}
